# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# Both of these are publishable, client-side values by design: the anon key is
# meant to ship in the browser bundle and is only safe because RLS is enforced
# server-side. The service_role key is NOT one of these and must never appear
# in this file, in the client, or in any committed file.

VITE_SUPABASE_URL=https://qkohesyqyknavriyhlsc.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Feature flags (optional; default off) -----------------------------------
# src/lib/flags.ts. Set to "true" at build time, or override per-device from
# the browser console: localStorage.setItem("mp.flag.fullDecompositionSplit","true")
#
# Stage 5b — full budget decomposition split (price / what-you-bought /
# basket-change / excluded) instead of the price-effect-only tier.
# VITE_FLAG_FULL_DECOMPOSITION_SPLIT=false
